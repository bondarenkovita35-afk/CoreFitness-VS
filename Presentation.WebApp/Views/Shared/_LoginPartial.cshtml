@using Microsoft.AspNetCore.Identity
@using Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav d-flex flex-row gap-3">

    @if (SignInManager.IsSignedIn(User))
    {
        <li>
            <a class="nav-link" href="/Memberships">My Account</a>
        </li>
        <li>
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home")"
                  method="post"
                  class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="cf-signin-btn">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li>
            <a class="nav-link" href="/Identity/Account/Register">Become Member</a>
        </li>
        <li>
            <a class="cf-signin-btn" href="/Identity/Account/Login">Sign In</a>
        </li>
    }
</ul>