@using Microsoft.AspNetCore.Identity
@using Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-center gap-3">

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" href="/MyPage">Min sida</a>
        </li>

        <li class="nav-item">
            <form action="/Identity/Account/Logout" method="post">
                <button class="btn btn-dark px-3 rounded-pill">Logga ut</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" href="/Identity/Account/Register">Registrera</a>
        </li>

        <li class="nav-item">
            <a class="btn btn-dark px-3 rounded-pill" href="/Identity/Account/Login">Logga in</a>
        </li>
    }

</ul>