<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreFitness</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="cf-body">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg cf-navbar">
        <div class="container-fluid">

            <!-- LOGO -->
            <a class="navbar-brand cf-logo" asp-controller="Home" asp-action="Index">
                ● CoreFitness
            </a>

            <!-- MOBILE BUTTON -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <!-- LEFT MENU -->
                <ul class="navbar-nav mx-auto cf-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="#">Fitness Centers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Memberships">Memberships</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Classes">Training</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Customer Service</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Store</a>
                    </li>
                </ul>

                <!-- RIGHT MENU -->
                <partial name="_LoginPartial" />

            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="cf-footer text-center">
        © 2026 CoreFitness
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>