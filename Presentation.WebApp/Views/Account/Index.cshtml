<div class="container mt-5">

    <h1 class="mb-4">My Account</h1>

    <div class="row">

        <!-- Левая часть -->
        <div class="col-md-5">
            <img src="/images/user.jpg" class="img-fluid rounded" />
        </div>

        <!-- Правая часть -->
        <div class="col-md-7">

            <h3>About Me</h3>

            <form>

                <div class="mb-3">
                    <label>First Name</label>
                    <input type="text" class="form-control" placeholder="Enter First Name" />
                </div>

                <div class="mb-3">
                    <label>Last Name</label>
                    <input type="text" class="form-control" placeholder="Enter Last Name" />
                </div>

                <div class="mb-3">
                    <label>Email</label>
                    <input type="email" class="form-control" placeholder="username@domain.com" />
                </div>

                <button class="btn btn-dark">Save</button>

            </form>

        </div>

    </div>

</div>