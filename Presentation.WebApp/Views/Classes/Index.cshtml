@model IEnumerable<Domain.Entities.GymClass>

@{
    ViewData["Title"] = "Pass";
}

<div class="container mt-4">
    <h1 class="mb-4">Tillgängliga pass</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Det finns inga pass just nu.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var gymClass in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="card-title">@gymClass.Name</h5>
                            <p class="mb-2"><strong>Datum:</strong> @gymClass.Date.ToString("yyyy-MM-dd HH:mm")</p>
                            <p class="mb-2"><strong>Instruktör:</strong> @gymClass.Instructor</p>
                            <p class="mb-0"><strong>Platser:</strong> @gymClass.Capacity</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>